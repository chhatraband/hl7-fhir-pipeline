{
  "datasets": [
    {
      "name": "stays01",
      "displayName": "stays",
      "queryLines": [
        "SELECT\n",
        "  f.visit_id,\n",
        "  f.admit_time,\n",
        "  d.date AS admit_date,\n",
        "  d.day_name,\n",
        "  d.is_weekend,\n",
        "  l.department,\n",
        "  p.age_group,\n",
        "  p.gender,\n",
        "  f.priority,\n",
        "  f.attending,\n",
        "  f.status,\n",
        "  f.los_hours,\n",
        "  ROUND(f.los_hours / 24, 2) AS los_days,\n",
        "  CAST(f.is_readmission_30d AS INT) AS readmit_flag,\n",
        "  CASE WHEN f.status = 'in-progress' THEN 1 ELSE 0 END AS in_hospital_flag\n",
        "FROM workspace.hl7_gold.fact_encounters f\n",
        "JOIN workspace.hl7_gold.dim_date d ON f.admit_date_key = d.date_key\n",
        "JOIN workspace.hl7_gold.dim_location l ON f.location_key = l.location_key\n",
        "JOIN workspace.hl7_gold.dim_patient p ON f.patient_key = p.patient_key"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "layout": [
        {
          "widget": {
            "name": "header",
            "multilineTextboxSpec": {
